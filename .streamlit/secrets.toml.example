# Streamlit Secrets Configuration Example
# 
# Copy this file to secrets.toml and fill in your actual values
# NEVER commit secrets.toml to git!
#
# Usage:
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   then edit secrets.toml with your values

# =============================================================================
# MODEL PROVIDER CONFIGURATION
# =============================================================================
# Choose "ollama" (local) or "openai" (cloud)
MODEL_PROVIDER = "ollama"  # Default: ollama for local development

# --- For Local Development (Ollama) ---
# Make sure Ollama is running: `ollama serve`
# No API key needed, just specify the model
OLLAMA_MODEL = "qwen2.5-coder:7b"  # or "llama3", "mistral", etc.

# --- For Cloud Deployment (OpenAI) ---
# Uncomment and fill in when deploying to Streamlit Cloud:
# MODEL_PROVIDER = "openai"
# OPENAI_API_KEY = "sk-proj-your-actual-api-key-here"
# OPENAI_MODEL = "gpt-4o-mini"  # or "gpt-4", "gpt-3.5-turbo"

# Get OpenAI API key from: https://platform.openai.com/api-keys

