# ======================================================================
# NLP-to-SQL Agent - Environment Configuration Template
# ======================================================================
# Copy this file to .env and fill in your values
# The application will work with defaults if .env is not present
# ======================================================================

# ======================================================================
# Datasource & Service (microservice deployment)
# ======================================================================
# Single read-only PostgreSQL connection, fixed at deploy time.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sts
# Shared secret required in the X-API-Key header. Leave empty to disable auth (dev).
API_KEY=

# ======================================================================
# LLM Provider Selection
# ======================================================================
# Options: "ollama" (local), "openai" (cloud), "google" (cloud)
MODEL_PROVIDER=openai

# ======================================================================
# Ollama Settings (For Local/Offline Development)
# ======================================================================
# Ollama is FREE and runs locally - recommended for development
# Download models: ollama pull qwen2.5-coder:7b
OLLAMA_MODEL=qwen2.5-coder:7b
# Alternative high-performance model (requires more RAM):
# OLLAMA_MODEL=a-kore/Arctic-Text2SQL-R1-7B
OLLAMA_BASE_URL=http://localhost:11434

# ======================================================================
# OpenAI Settings (For Cloud Deployment - Paid API)
# ======================================================================
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# ======================================================================
# Google Gemini Settings (For Cloud Deployment - Free Tier Available)
# ======================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
# Recommended for speed + accuracy with free tier
# GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_MODEL=gemini-2.0-flash-exp

# ======================================================================
# Performance Settings
# ======================================================================
# Enable AI-powered chart recommendations (requires extra LLM call)
# Set to false for faster responses (uses rule-based recommendations)
ENABLE_INTELLIGENT_VIZ=false

# ======================================================================
# RAG Configuration (Few-shot Example Retrieval)
# ======================================================================
# Distance threshold for filtering examples (lower = more strict)
# RAG_DISTANCE_THRESHOLD=15.0
# Number of SQL examples to retrieve for few-shot learning
# RAG_TOP_K=3

# ======================================================================
# Schema RAG Configuration
# ======================================================================
# Number of database tables to retrieve for context
# SCHEMA_TOP_K=5

# ======================================================================
# SQL Execution Limits
# ======================================================================
# Maximum number of rows a query can return (DoS prevention)
# MAX_SQL_LIMIT=500
# Number of retries when SQL fails (self-correction)
# MAX_RETRIES=2

# ======================================================================
# Embedding Model (For Semantic Search)
# ======================================================================
# This model supports Thai language for RAG and Schema search
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ======================================================================
# Logging Configuration
# ======================================================================
# LOG_FILE_JSONL=query_logs.jsonl
# LOG_FILE_CSV=query_logs.csv

# ======================================================================
# CORS Settings (For Production Deployment)
# ======================================================================
# Comma-separated list of allowed frontend origins. Use "*" for local dev.
# Example: CORS_ORIGINS=https://your-app.vercel.app
# CORS_ORIGINS=*

# ======================================================================
# Notes:
# ======================================================================
# 1. For local development: Use Ollama (no API key needed, free)
# 2. For production: Consider OpenAI or Google Gemini for better accuracy
# 3. Google Gemini offers a generous free tier - good for testing
# 4. All settings have defaults in core/config.py if not specified here
# ======================================================================
